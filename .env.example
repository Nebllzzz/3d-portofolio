# Variabel untuk docker-compose.yml (bukan untuk aplikasi Laravel/Vite).
# Salin jadi `.env`:  cp .env.example .env

# UID/GID user host — dipakai saat build supaya file yang ditulis container
# (storage/, bootstrap/cache/) tetap dimiliki user kamu di bind mount.
# Cek dengan: id -u && id -g
UID=1000
GID=1000

# Kredensial MySQL — harus sama dengan backend/.env
DB_DATABASE=portfolio_nandi
DB_USERNAME=nandi
DB_PASSWORD=nandi
DB_ROOT_PASSWORD=root

# URL antar service (dilihat dari browser, bukan dari dalam container)
APP_URL=http://localhost:6011
FRONTEND_URL=http://localhost:6010
VITE_API_URL=http://localhost:6011
